{
  "name": "questionme",
  "version": "0.1.0",
  "description": "Questions from an LLM agent, answered on your phone: hundreds at a time, with rich content (files, code, diffs, diagrams, mockups), branching follow-ups, and answers saved in the project where the agent reads only what's new. A web page, a CLI and an MCP server.",
  "type": "module",
  "bin": {
    "questionme": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-schema.mjs",
    "build:client": "node scripts/build-client.mjs",
    "watch:client": "node scripts/build-client.mjs --watch",
    "dev": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "questions",
    "questionnaire",
    "llm",
    "agent",
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "human-in-the-loop",
    "decisions",
    "review",
    "phone",
    "cli",
    "server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickerMonkey/questionme.git"
  },
  "homepage": "https://github.com/ClickerMonkey/questionme#readme",
  "bugs": {
    "url": "https://github.com/ClickerMonkey/questionme/issues"
  },
  "author": "ClickerMonkey",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.3.0",
    "playwright": "^1.64.1",
    "shiki": "^4.6.0",
    "temml": "^0.14.0",
    "typescript": "^5.9.3"
  }
}
